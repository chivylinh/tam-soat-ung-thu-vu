# Cấu hình phần mềm quản lý phòng khám
# Sửa file này bằng Notepad, lưu lại, rồi khởi động lại phần mềm.
# Dòng bắt đầu bằng # là ghi chú.

# Tên phòng khám (hiện trên màn hình và in trên phiếu)
CLINIC_NAME=Phòng khám Đa khoa

# Cổng truy cập: http://localhost:3000
PORT=3000

# Số bản sao lưu hằng ngày được giữ lại (trong thư mục data\backups)
BACKUP_KEEP=30

# Thư mục sao lưu khác (ví dụ ổ D hoặc thư mục Google Drive/OneDrive). Để trống = data\backups
# BACKUP_DIR=D:\SaoLuuPhongKham
