# Cấu hình phần mềm quản lý phòng khám
# Sửa file này bằng Notepad, lưu lại, rồi khởi động lại phần mềm.
# Dòng bắt đầu bằng # là ghi chú.

# Tên phòng khám (hiện trên màn hình và in trên phiếu)
CLINIC_NAME=Phòng khám Đa khoa

# Số điện thoại phòng khám (dùng trong tin nhắn nhắc lịch)
CLINIC_PHONE=

# Cổng truy cập: http://localhost:3000
PORT=3000

# Số bản sao lưu hằng ngày được giữ lại (trong thư mục data\backups)
BACKUP_KEEP=30

# Thư mục sao lưu khác (ví dụ ổ D hoặc thư mục Google Drive/OneDrive). Để trống = data\backups
# BACKUP_DIR=D:\SaoLuuPhongKham

# ---- Bảo hiểm y tế (xuất XML giám định) ----
# Mã cơ sở khám chữa bệnh do BHXH cấp (bắt buộc để xuất XML)
BHYT_MA_CSKCB=
# Lương cơ sở hiện hành (đồng). Chi phí 1 lần khám dưới 15% mức này thì BHYT trả 100%. Kiểm tra lại khi Nhà nước điều chỉnh.
LUONG_CO_SO=2340000

# ---- Mẫu tin nhắn nhắc lịch ----
# Từ khóa: {ten} {phongkham} {khoa} {gio} {ngay} {sdt}
# REMINDER_APPOINTMENT=Kính gửi {ten}: {phongkham} xin nhắc lịch hẹn khám {khoa} lúc {gio} ngày {ngay}. Cần đổi lịch xin gọi {sdt}.
# REMINDER_FOLLOWUP=Kính gửi {ten}: {phongkham} xin nhắc lịch tái khám {khoa} ngày {ngay}. Cần hỗ trợ xin gọi {sdt}.
