<%- include('../partials/header') %>
<div class="page-head">
  <div><div class="eyebrow">Hóa đơn <%= inv.code %></div><h1><a href="/patients/<%= patient.id %>"><%= patient.full_name %></a></h1>
    <div class="muted"><%= patient.code %> · Lượt khám <a href="/visits/<%= visit.id %>"><%= fmtDate(visit.visit_date) %> – STT <%= visit.queue_number %></a> · <%= visit.dept_name || '' %></div></div>
  <div class="actions">
    <%- include('../partials/badge', { map: INVOICE_STATUS, status: inv.status }) %>
    <a class="btn" href="/invoices/<%= inv.id %>/print" target="_blank">In hóa đơn</a>
  </div>
</div>
<div class="grid grid-main">
  <div class="card">
    <h2>Chi tiết</h2>
    <% if (items.length) { %>
    <div class="table-wrap"><table>
      <thead><tr><th>Nội dung</th><th>Loại</th><th class="num">SL</th><th class="num">Đơn giá</th><th class="num">Thành tiền</th></tr></thead>
      <tbody>
      <% items.forEach(it => { %>
        <tr><td><%= it.description %></td><td><%= it.item_type === 'service' ? 'Dịch vụ' : 'Thuốc' %></td><td class="num"><%= it.quantity %></td><td class="num"><%= money(it.unit_price) %></td><td class="num"><%= money(it.amount) %></td></tr>
      <% }) %>
      </tbody>
      <tfoot>
        <tr><td colspan="4" class="right">Tạm tính</td><td class="num"><%= money(inv.subtotal) %></td></tr>
        <% if (inv.discount) { %><tr><td colspan="4" class="right">Giảm giá</td><td class="num">−<%= money(inv.discount) %></td></tr><% } %>
        <tr><td colspan="4" class="right">Thành tiền</td><td class="num"><%= money(inv.total) %></td></tr>
      </tfoot>
    </table></div>
    <% } else { %><div class="empty">Hóa đơn chưa có khoản nào.</div><% } %>
    <% if (inv.note) { %><p class="muted">Ghi chú: <%= inv.note %></p><% } %>
  </div>
  <div>
    <% if (inv.status === 'unpaid' && can('cashier')) { %>
    <div class="card">
      <h2>Thu tiền</h2>
      <form method="post" action="/invoices/<%= inv.id %>/pay" data-confirm="Xác nhận đã thu tiền? Thuốc sẽ được trừ kho.">
        <%- include('../partials/csrf') %>
        <div class="field"><label>Hình thức thanh toán</label>
          <select name="payment_method"><% Object.entries(PAYMENT_METHODS).forEach(([k, v]) => { %><option value="<%= k %>"><%= v %></option><% }) %></select>
        </div>
        <div class="field"><label>Giảm giá (₫)</label><input name="discount" type="number" min="0" max="<%= inv.subtotal %>" step="1000" value="0"></div>
        <div class="field"><label>Ghi chú</label><input name="note"></div>
        <button class="btn primary" style="width:100%;justify-content:center" <%= items.length ? '' : 'disabled' %>>Thu <%= money(inv.total) %></button>
      </form>
    </div>
    <% } else if (inv.status === 'paid') { %>
    <div class="card">
      <h2>Đã thanh toán</h2>
      <dl class="kv"><dt>Thời gian</dt><dd><%= fmtDateTime(inv.paid_at) %></dd><dt>Hình thức</dt><dd><%= PAYMENT_METHODS[inv.payment_method] || '' %></dd><dt>Thu ngân</dt><dd><%= cashier ? cashier.full_name : '' %></dd></dl>
    </div>
    <% } %>
    <% if (inv.status !== 'cancelled' && user.role === 'admin') { %>
    <div class="card">
      <h2>Hủy hóa đơn</h2>
      <p class="muted small">Chỉ quản trị viên. Thuốc đã xuất sẽ được hoàn kho; các khoản trở lại trạng thái chờ thu.</p>
      <form method="post" action="/invoices/<%= inv.id %>/cancel" data-confirm="Hủy hóa đơn này?">
        <%- include('../partials/csrf') %>
        <div class="field"><label>Lý do</label><input name="reason" required></div>
        <button class="btn danger">Hủy hóa đơn</button>
      </form>
    </div>
    <% } %>
  </div>
</div>
<%- include('../partials/footer') %>
