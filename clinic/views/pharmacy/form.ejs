<%- include('../partials/header') %>
<div class="page-head"><div><h1><%= title %></h1></div></div>
<div class="card" style="max-width:820px">
  <%- include('../partials/errors', { errors }) %>
  <form method="post" action="<%= action %>">
    <%- include('../partials/csrf') %>
    <div class="form-grid">
      <div class="field"><label>Mã thuốc</label><input name="code" value="<%= m.code || '' %>"></div>
      <div class="field"><label>Tên thuốc *</label><input name="name" value="<%= m.name || '' %>" required></div>
      <div class="field"><label>Hoạt chất</label><input name="active_ingredient" value="<%= m.active_ingredient || '' %>"></div>
      <div class="field"><label>Đơn vị tính</label><input name="unit" value="<%= m.unit || 'viên' %>" list="units"><datalist id="units"><option>viên</option><option>gói</option><option>chai</option><option>lọ</option><option>ống</option><option>tuýp</option><option>hộp</option></datalist></div>
      <div class="field"><label>Giá bán (₫)</label><input name="price" type="number" min="0" value="<%= m.price ?? 0 %>"></div>
      <div class="field"><label>Tồn tối thiểu (cảnh báo)</label><input name="min_stock" type="number" min="0" value="<%= m.min_stock ?? 0 %>"></div>
      <div class="field"><label>Hạn dùng</label><input name="expiry_date" type="date" value="<%= m.expiry_date || '' %>"></div>
      <% if (!m.id) { %><div class="field"><label>Tồn đầu kỳ</label><input name="stock" type="number" min="0" value="<%= m.stock || 0 %>"></div><% } %>
      <div class="field"><label>Hàm lượng</label><input name="strength" value="<%= m.strength || '' %>" placeholder="500mg"></div>
      <div class="field"><label>Đường dùng</label><input name="route" value="<%= m.route || '' %>" placeholder="Uống"></div>
      <div class="field"><label>Số đăng ký</label><input name="reg_no" value="<%= m.reg_no || '' %>"></div>
      <div class="field"><label>Mã thuốc BHYT (để trống nếu không thanh toán BHYT)</label><input name="bhyt_code" value="<%= m.bhyt_code || '' %>"></div>
      <div class="field"><label>Trạng thái</label><select name="active"><option value="1" <%= m.active ? 'selected' : '' %>>Đang dùng</option><option value="0" <%= m.active ? '' : 'selected' %>>Ngừng dùng</option></select></div>
    </div>
    <div class="actions"><button class="btn primary">Lưu</button><a class="btn" href="/pharmacy">Hủy</a></div>
  </form>
</div>
<%- include('../partials/footer') %>
