<%- include('../partials/header') %>
<div class="page-head"><div><h1>Danh mục dịch vụ &amp; bảng giá</h1><div class="muted">Thay đổi giá chỉ áp dụng cho chỉ định mới.</div></div></div>
<datalist id="cats"><% categories.forEach(c => { %><option><%= c %></option><% }) %></datalist>
<div class="card">
  <h3>Thêm dịch vụ</h3>
  <form method="post" action="/admin/services" class="inline-form mb">
    <%- include('../partials/csrf') %>
    <input name="code" placeholder="Mã" style="width:90px">
    <input name="name" placeholder="Tên dịch vụ" required style="flex:2;min-width:200px">
    <input name="category" placeholder="Nhóm" list="cats" style="width:170px" required>
    <input name="price" type="number" min="0" step="1000" placeholder="Giá" style="width:120px" required>
    <input name="bhyt_code" placeholder="Mã BHYT (nếu có)" style="width:150px">
    <button class="btn primary">Thêm</button>
  </form>
  <div class="table-wrap"><table>
    <tbody>
    <% list.forEach(s => { %>
      <tr><td style="padding:0">
        <form method="post" action="/admin/services" class="inline-form" style="padding:6px 10px">
          <%- include('../partials/csrf') %><input type="hidden" name="id" value="<%= s.id %>">
          <input name="code" value="<%= s.code || '' %>" style="width:90px">
          <input name="name" value="<%= s.name %>" required style="flex:2;min-width:200px">
          <input name="category" value="<%= s.category %>" list="cats" style="width:170px">
          <input name="price" type="number" min="0" step="1000" value="<%= s.price %>" style="width:120px">
          <input name="bhyt_code" value="<%= s.bhyt_code || '' %>" placeholder="Mã BHYT" style="width:150px">
          <select name="active"><option value="1" <%= s.active ? 'selected' : '' %>>Đang dùng</option><option value="0" <%= s.active ? '' : 'selected' %>>Ngừng</option></select>
          <button class="btn small">Lưu</button>
        </form>
      </td></tr>
    <% }) %>
    </tbody>
  </table></div>
</div>
<%- include('../partials/footer') %>
